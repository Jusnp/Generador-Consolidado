# Core Authentik values. Generate each secret uniquely for the production host.
AUTHENTIK_TAG=2026.8.0
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_USER=authentik_user
AUTHENTIK_DB_PASS=
AUTHENTIK_DB_NAME=authentik_prod

# Public URL served by the reverse proxy. It must not include a trailing slash.
AUTHENTIK_WEB__URL=https://auth.comitedeestudiosmedicos.com.co
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_ERROR_REPORTING__ENABLED=false

# Only set this if the reverse proxy does not connect from Docker's private network.
# AUTHENTIK_LISTEN__TRUSTED_PROXY_CIDRS=127.0.0.0/8,172.16.0.0/12,::1/128
