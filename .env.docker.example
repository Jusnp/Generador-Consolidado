# Entorno Docker + PostgreSQL de desarrollo (json-excel / SIRUTA).
# Copiar a .env.docker (no versionado) y reemplazar los valores CAMBIAR_*.
# Dentro del contenedor Laravel lee este archivo como su .env; el .env de Laragon no se usa.

APP_NAME=Laravel
APP_ENV=local
# Generar con: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base PostgreSQL exclusiva de Docker. Dentro de la red de Compose: servicio "postgres", puerto 5432.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=json_excel_dev
DB_USERNAME=json_excel
# Debe coincidir con docker/secrets/postgres_password.txt (clave del contenedor PostgreSQL).
DB_PASSWORD=CAMBIAR_clave_desarrollo

SESSION_DRIVER=database
# Cookie propia: Laragon y Docker comparten localhost:8000 y así no se cierran la sesión entre sí.
SESSION_COOKIE=siruta_docker_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Laravel"

# Authentik (proveedor externo): mismos valores que el .env de Laragon. El retorno registrado
# en Authentik es http://localhost:8000/auth/authentik/callback.
AUTHENTIK_ENABLED=true
AUTHENTIK_BASE_URL=https://auth.comitedeestudiosmedicos.com.co
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/authentik/callback"
AUTHENTIK_SCOPES="openid profile email"
AUTHENTIK_API_TOKEN=
# Token de una cuenta de servicio exclusiva de SIRUTA (sin superusuario). Modo "Subject mode"
# del proveedor OIDC: hashed_user_id, user_id, user_uuid o user_username.
AUTHENTIK_SUBJECT_MODE=hashed_user_id
# UUID del grupo exclusivo de SIRUTA para las cuentas que SIRUTA crea (opcional).
AUTHENTIK_ACCESS_GROUP=
AUTHENTIK_USER_PATH=users/siruta

# La María: mismos valores que el .env de Laragon para obtener resultados idénticos.
# Las rutas de informes deben ser rutas visibles dentro del contenedor; vacías, el informe
# administrativo se carga desde el formulario.
LA_MARIA_POLITICA_DISPENSACION=CONDICIONADA
LA_MARIA_INFORMES_ADMIN_REQUERIDOS=true
LA_MARIA_INFORME_ADMIN_PROSTATA=
LA_MARIA_INFORME_ADMIN_CERVIX=
